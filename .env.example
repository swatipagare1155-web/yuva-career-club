# ============================================================================
# YUVA CAREER PLATFORM ENVIRONMENT TEMPLATE (NO SECRETS)
# ============================================================================

NODE_ENV=production
PORT=3000

# Base Platform Domain
BASE_URL=http://localhost:3000

# JSON Web Token Secret (Replace with 256-bit secure random key in production)
JWT_SECRET=replace_with_secure_random_64_character_hex_key

# Payment Gateway Configuration (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret
PAYMENT_WEBHOOK_SECRET=yuva_rzp_webhook_secret_2026

# Payout Banking Integration (RazorpayX / Cashfree Payouts)
RAZORPAYX_ACCOUNT_NUMBER=2323230000000000
RAZORPAYX_KEY_ID=replace_with_payout_key_id
RAZORPAYX_KEY_SECRET=replace_with_payout_key_secret

# Statutory Tax Configuration
TDS_SECTION=194H
TDS_DEFAULT_PERCENT=5.0
GST_RATE_PERCENT=18.0

# Payout Threshold Policy
MIN_PAYOUT_INR=500
CHECKER_THRESHOLD_INR=10000
VALIDATION_HOLD_DAYS=15
ATTRIBUTION_WINDOW_DAYS=30
